{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BraketDeviceDiscovery",
      "Effect": "Allow",
      "Action": [
        "braket:GetDevice",
        "braket:SearchDevices"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BraketTaskRead",
      "Effect": "Allow",
      "Action": [
        "braket:GetQuantumTask",
        "braket:SearchQuantumTasks",
        "braket:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BraketSpendingLimitRead",
      "Effect": "Allow",
      "Action": [
        "braket:SearchSpendingLimits"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResultsBucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::<RESULTS_BUCKET>"
    },
    {
      "Sid": "ResultsObjectRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::<RESULTS_BUCKET>/*"
    },
    {
      "Sid": "BraketLogsRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:*:<AWS_ACCOUNT_ID>:log-group:/aws/braket*"
    },
    {
      "Sid": "CostEstimationRead",
      "Effect": "Allow",
      "Action": [
        "pricing:GetProducts",
        "servicequotas:GetServiceQuota",
        "budgets:ViewBudget"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CostExplorerRead",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BudgetAlertTopicRead",
      "Effect": "Allow",
      "Action": [
        "sns:GetTopicAttributes",
        "sns:ListSubscriptionsByTopic"
      ],
      "Resource": "arn:aws:sns:*:<AWS_ACCOUNT_ID>:shor-braket-*"
    },
    {
      "Sid": "IamPolicySimulation",
      "Effect": "Allow",
      "Action": [
        "iam:SimulatePrincipalPolicy",
        "iam:GetContextKeysForPrincipalPolicy"
      ],
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ShorBraketExecutionRole",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ShorBraketAqtRole",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:user/shor-braket-operator",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:user/shor-braket-monitor"
      ]
    }
  ]
}
