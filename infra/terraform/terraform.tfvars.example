# shor-braket — Terraform 変数のテンプレート
#
# cp terraform.tfvars.example terraform.tfvars して値を埋めること。
# terraform.tfvars は .gitignore 対象 (*.tfvars)。値をコミットしないこと。
#
# 対応する変数定義は variables.tf (Phase 3 で作成)。

# ---- アカウント / リージョン ----
# 任意。設定すると、別アカウントのプロファイルで apply しようとしたときに作成前に失敗する
aws_account_id = "000000000000"

# 結果保存用 S3 バケットを置くリージョン。
# Braket は「タスクを投入したリージョン」のバケットに結果を書く。採用した QPU 3 機は
# すべて eu-north-1 にあり、SV1/DM1 は実行経路から外した (ADR-0004) ので、使うのはここだけ
results_bucket_region = "eu-north-1"

# ---- S3 ----
# amazon-braket- プレフィクスを推奨 (AmazonBraketFullAccess の前提に合わせる)
results_bucket_name = "amazon-braket-CHANGE-ME"

# 生の測定結果を Glacier に移すまでの日数
results_transition_days = 90

# ---- IAM ----
# 操作者ユーザー。読み取り + 実行ロール / AQT ロールへの assume。MFA デバイスを登録する
operator_user_name = "shor-braket-operator"
# 監視ユーザー。読み取りのみで assume 権限を持たない
monitor_user_name = "shor-braket-monitor"

# ロール名。変えるなら infra/iam/*.json 内の参照も合わせる (plan 時に precondition が検出する)
# execution_role_name = "ShorBraketExecutionRole"
# AQT 専用ロール。高額機に触るには別の assume が要る (ADR-0004)
# aqt_role_name = "ShorBraketAqtRole"

# デバイスの拒否リストは infra/iam/shor-braket-*-policy.json が唯一の定義。
# Terraform はその JSON をそのまま読み込む (二重管理しない)

# ---- コスト ----
monthly_budget_usd = 100

# 予算アラートの通知先。SNS のサブスクリプション確認メールが届く
budget_notification_email = "CHANGE-ME@example.com"

# アラートを出す閾値 (%). 予測値 100% も別途通知する
budget_alert_thresholds = [50, 80, 100]

# ---- タグ ----
tags = {
  Project     = "shor-braket"
  ManagedBy   = "terraform"
  AmazonBraket = "true"
}
