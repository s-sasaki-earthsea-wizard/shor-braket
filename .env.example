# shor-braket — 環境変数のテンプレート
#
# cp .env.example .env して値を埋めること。
# .env は .gitignore 対象。値をコミットしないこと。
#
# Makefile はこのファイルが存在すれば自動で読み込んで export する。
# 書式は KEY=value のみ。クォート・スペース・シェル展開は使わないこと。

# ---- AWS ----
AWS_REGION=eu-north-1
AWS_ACCOUNT_ID=000000000000

# 読み取り専用プロファイル (MFA 不要)。デバイス一覧・価格取得・結果閲覧に使う
AWS_PROFILE_RO=shor-braket-ro
# 実行プロファイル (MFA 必須の assume role)。submit-* でのみ使う
AWS_PROFILE_EXEC=shor-braket-exec

# 既定は読み取り専用。課金操作は明示的に EXEC に切り替える
AWS_PROFILE=shor-braket-ro
# Terraform (make tf-*) に使う管理者プロファイル。MFA 必須の assume role にする (infra/iam/README.md §11)。
# root のアクセスキーは使わない。make tf-plan / tf-apply は root を検出すると拒否する
AWS_PROFILE_ADMIN=admin

# ---- IAM ----
# iam-verify が評価するプリンシパル (user/<name> または role/<name>)
IAM_PRINCIPAL=role/ShorBraketExecutionRole
# iam-verify が「実行権限を持たない」ことを確認する監視ユーザー。空なら省略される
IAM_MONITOR_PRINCIPAL=user/shor-braket-monitor

# ---- Braket ----
# 結果保存用 S3 バケット。amazon-braket- プレフィクスを推奨
BRAKET_RESULTS_BUCKET=amazon-braket-CHANGE-ME
# 既定のデバイス論理名: sv1 | dm1 | garnet | emerald | cepheus
BRAKET_DEFAULT_DEVICE=sv1
# 投入時に付けるキャンペーンタグ。通常は空。
# AQT はこの値が device-comparison のときだけ IAM が通す (infra/iam/README.md §6.1)
BRAKET_CAMPAIGN=

# ---- コストガードレール ----
# 1 回の投入で許容する上限 (USD)。これを超えると明示指定なしでは拒否する
BRAKET_MAX_COST_USD=10
# 月次予算 (USD)。AWS Budgets の閾値と一致させること
BRAKET_MONTHLY_BUDGET_USD=100
# QPU タスクあたりの定額 (USD)。get-device では取得できないため設定値として持つ
BRAKET_TASK_PRICE_USD=0.30
